# Normalize text files across macOS, Linux, and Windows.
* text=auto
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
gradlew text eol=lf

# Keep images, fonts, and archives as binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
